# База — переменные окружения
# Скопировать в .env и заполнить значения

# Публичный URI приложения (для production — https://baza.company.com)
BAZA_PUBLIC_URI=http://localhost:9001

# Секретный ключ (сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
BAZA_SECRET_KEY=change-this-insecure-key

# Версия образов (соответствует тегу upstream)
BAZA_VERSION=latest

# Пароль БД (для production — надёжный пароль)
BAZA_DB_PASSWORD=penpot

# SMTP (для production — реальный SMTP)
BAZA_SMTP_FROM=no-reply@example.com
BAZA_SMTP_REPLY_TO=no-reply@example.com
